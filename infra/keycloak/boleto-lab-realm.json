{
  "realm": "boleto-lab",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "clientScopes": [
    {
      "name": "analytics:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "bpl-audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "boleto-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "boleto-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "boletos:issue",
      "protocol": "openid-connect",
      "attributes": {
