POSTGRES_PORT=5433
POSTGRES_DB=boleto_lab
POSTGRES_USER=boleto_dev
POSTGRES_PASSWORD=synthetic-local-only
KEYCLOAK_PORT=8180
# Required before the first Keycloak boot. Set both values only in ignored .env.
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=
KAFKA_PORT=9092
# Directory name generated by infra/kafka/generate-local.py.
# KAFKA_SECRET_INSTANCE=local
KAFKA_UI_PORT=8085
JAEGER_PORT=16686
OTLP_PORT=4318
# MCP reader must be provisioned from infra/postgres/provision-mcp-reader.sql.
MCP_SERVER_PORT=8090

# Optional compose.chatgpt.yaml settings. Put actual values in the ignored .env.
# KEYCLOAK_PUBLIC_HOSTNAME=auth-boleto.example.test
# Set to the resource observed through the actual ChatGPT tunnel connection.
# CHATGPT_MCP_RESOURCE=
# CHATGPT_KC_ADMIN_USERNAME=
# CHATGPT_KC_ADMIN_PASSWORD=
# CHATGPT_CLOUDFLARE_TUNNEL_TOKEN=
MCP_DATABASE_USERNAME=boleto_mcp_reader
MCP_DATABASE_PASSWORD=synthetic-mcp-reader-only
