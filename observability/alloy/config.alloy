prometheus.scrape "boleto" {
  targets = [{"__address__" = "boleto-payment-lab:8080"}]
  job_name = "boleto-payment-lab"
  metrics_path = "/actuator/prometheus"
  scrape_interval = "30s"
  scrape_timeout = "10s"
  sample_limit = 15000
  label_limit = 32
  follow_redirects = false

  oauth2 {
    client_id = "boleto-metrics"
    client_secret = sys.env("BPL_METRICS_CLIENT_SECRET")
    scopes = ["ops:metrics"]
    token_url = "http://keycloak:8080/realms/boleto-lab/protocol/openid-connect/token"
  }

  forward_to = [prometheus.remote_write.grafanacloud.receiver]
}

prometheus.remote_write "grafanacloud" {
  endpoint {
    url = "https://" + sys.env("GRAFANA_CLOUD_PROM_HOST") + "/api/prom/push"
    follow_redirects = false
    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROM_USER")
      password = sys.env("GRAFANA_CLOUD_METRICS_TOKEN")
    }
    queue_config {
      max_shards = 2
      capacity = 5000
      max_samples_per_send = 1000
      batch_send_deadline = "5s"
      min_backoff = "250ms"
      max_backoff = "30s"
      retry_on_http_429 = true
    }
  }
  wal {
    truncate_frequency = "30m"
    min_keepalive_time = "5m"
    max_keepalive_time = "4h"
  }
}
