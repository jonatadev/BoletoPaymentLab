    {
      "name": "Issue boleto",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('dueDate', new Date(Date.now() + 7 * 86400000).toISOString().slice(0, 10));",
              "pm.environment.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));",
              "pm.environment.set('boletoId', '');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const id = pm.response.json().id;",
              "  pm.test('Boleto UUID is returned', () => pm.expect(id).to.match(/^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i));",
              "  if (typeof id === 'string') pm.environment.set('boletoId', id);",
              "}",
              "if (pm.response.code === 201) {",
              "  pm.test('Location identifies the issued boleto', () => {",
              "    pm.expect(pm.response.headers.get('Location')).to.eql('/api/v1/boletos/' + pm.response.json().id);",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/boletos",
        "body": {
          "mode": "raw",
          "raw": "{\"customerId\":\"{{customerId}}\",\"amount\":10.00,\"dueDate\":\"{{dueDate}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{issuerToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
