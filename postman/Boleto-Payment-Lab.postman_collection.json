        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const revisions = pm.response.json(); pm.collectionVariables.unset('latestRevision'); pm.collectionVariables.unset('firstComparedRevision'); if (revisions.length) pm.collectionVariables.set('latestRevision', revisions[0].revision); if (revisions.length > 1) pm.collectionVariables.set('firstComparedRevision', revisions[1].revision); }"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/boletos/{{boletoId}}/revisions?size=20",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{operatorToken}}", "type": "string" }]
        }
