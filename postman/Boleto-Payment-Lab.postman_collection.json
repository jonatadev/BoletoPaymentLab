{
  "info": {
    "name": "Boleto Payment Lab",
    "description": "Local synthetic lab. Obtain client tokens first. Issue a fresh boleto for each terminal transition.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "dueDate",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Get token - issuer",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.environment.set('issuerToken', pm.response.json().access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "url": "{{oidcIssuer}}/protocol/openid-connect/token",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials"
            },
            {
              "key": "client_id",
              "value": "boleto-issuer"
            },
            {
              "key": "client_secret",
              "value": "{{issuerClientSecret}}"
            }
          ]
        }
      }
    },
    {
      "name": "Get token - reader",
