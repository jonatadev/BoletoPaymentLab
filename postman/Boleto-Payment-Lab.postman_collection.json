              "pm.test('Same boleto UUID', () => pm.expect(pm.response.json().id).to.eql(pm.environment.get('boletoId')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/boletos/{{boletoId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{readerToken}}",
              "type": "string"
            }
          ]
